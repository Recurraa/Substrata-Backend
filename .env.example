# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/substrata?schema=public"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Stellar ───────────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
# mainnet: https://horizon.stellar.org
# testnet: https://horizon-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Platform treasury keypair (signs billing transactions)
STELLAR_TREASURY_SECRET_KEY=S...

# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed Substrata subscription contract (see Substrata-Contract DEPLOYMENTS.md)
SUBSCRIPTION_CONTRACT_ID=

# ─── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret-min-32-chars

# ─── Billing ───────────────────────────────────────────────────────────────────
# Grace period in hours before subscription is cancelled after failed payment
GRACE_PERIOD_HOURS=48
# Max retry attempts for failed payments
MAX_PAYMENT_RETRIES=3
# Test mode — no real transactions are submitted
TEST_MODE=false
# Prefer Soroban execute_billing over Horizon payment ops when contract ID is set
USE_SOROBAN_BILLING=true
